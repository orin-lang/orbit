function fib(n: int): int {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
}

function sieve(n: usize): int {
  let flags: int[] = [];
  let i: usize = 0;
  while (i <= n) { flags.push(1); i += 1; }
  flags[0] = 0;
  flags[1] = 0;
  i = 2;
  while (i * i <= n) {
    if (flags[i] == 1) {
      let j = i * i;
      while (j <= n) { flags[j] = 0; j += i; }
    }
    i += 1;
  }
  let count = 0;
  i = 0;
  while (i <= n) { count += flags[i]; i += 1; }
  return count;
}

function collatzSteps(n: int): int {
  let x = n;
  let steps = 0;
  while (x != 1) {
    x = x % 2 == 0 ? x / 2 : 3 * x + 1;
    steps += 1;
  }
  return steps;
}

function main(): void {
  console.log("fib(35)=" + fib(35).toString());
  console.log("primes<=5000000: " + sieve(5000000).toString());
  let total = 0;
  let n = 1;
  while (n <= 300000) { total += collatzSteps(n); n += 1; }
  console.log("collatz(1..300000) steps: " + total.toString());
  let words: string[] = [];
  let w = 0;
  while (w < 1000) { words.push("w" + (w * 7919 % 1000).toString()); w += 1; }
  console.log("words: " + words.length.toString() + " last " + words[999]);
}
