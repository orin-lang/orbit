(module
  (import "orbit:fs/v1" "open" (func $open (param i64 i64 i32) (result i64)))
  (import "orbit:fs/v1" "read" (func $read (param i64 i64 i64) (result i64)))
  (import "orbit:process/v1" "arg_count" (func $argc (result i32)))
  (import "orbit:process/v1" "env_get" (func $env (param i64 i64 i64 i64) (result i64)))
  (import "orbit:process/v1" "stdin_read" (func $stdin (param i64 i64 i64) (result i64)))
  (memory (export "memory") 1)
  (data (i32.const 0) "/d/a.txt")
  (data (i32.const 16) "/d/out.txt")
  (data (i32.const 32) "FOO")
  ;; read("/d/a.txt") + 10 * argc + 100 * len(env FOO)
  (func (export "run") (result i64)
    (local $h i64) (local $n i64) (local $e i64)
    (local.set $h (call $open (i64.const 0) (i64.const 8) (i32.const 0)))
    (if (i64.lt_s (local.get $h) (i64.const 0)) (then (return (local.get $h))))
    (local.set $n (call $read (local.get $h) (i64.const 256) (i64.const 64)))
    (local.set $e (call $env (i64.const 32) (i64.const 3) (i64.const 512) (i64.const 64)))
    (i64.add (local.get $n)
      (i64.add (i64.mul (i64.extend_i32_u (call $argc)) (i64.const 10))
               (i64.mul (local.get $e) (i64.const 100)))))
  (func (export "wr") (result i64)
    (call $open (i64.const 16) (i64.const 10) (i32.const 1)))
  (func (export "in") (result i64)
    (call $stdin (i64.const 256) (i64.const 64) (i64.const -1))))
